{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/human-experiment/:path*", "destination": "/public/:path*" },
    { "source": "/general_assets/:path*", "destination": "/general_assets/:path*" }
  ],
  "headers": [
    {
      "source": "/human-experiment/stimuli/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/human-experiment/vendor/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/human-experiment/trial_pool.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  }
}
